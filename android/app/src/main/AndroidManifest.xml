<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Necessária para acessar as APIs da aplicação -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Câmera -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Localização aproximada e precisa -->
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
        Informa que a câmera é opcional.
        Assim, a aplicação ainda pode ser instalada em dispositivos sem câmera.
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!--
        Localização via GPS também é opcional.
        A aplicação pode utilizar localização por rede quando disponível.
    -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:label="poc_unimed"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!--
                Tema aplicado enquanto o Flutter é inicializado.
                Depois da inicialização, o NormalTheme permanece
                como tema de fundo da Activity.
            -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            Utilizado pelo Flutter para gerar e registrar
            automaticamente os plugins nativos.
        -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

    <!--
        Permite consultar Activities capazes de processar textos.
        Essa configuração é utilizada pelo ProcessTextPlugin do Flutter.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

</manifest>